# Groq API Key (Required for server inference)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Admin Secret Key to secure memory management endpoints (/api/memory)
# In production, set this to a strong secret token
ADMIN_SECRET_KEY=

# Security: Allow clients to supply an API key in request payloads (true/false)
# Set to 'false' in production public deployments
ALLOW_CLIENT_API_KEY=true

# Security: Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Default Groq Model
GROQ_MODEL=llama-3.3-70b-versatile
